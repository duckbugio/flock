# Managed by Ansible — weekly reclaim of unused Docker images + build cache.
# `until=` compares the image's CREATION time (when CI built it), not when this host
# pulled it, so a freshly pulled image can already be older than {{ docker_prune_keep_hours }}h
# and is reclaimed as soon as nothing runs it: after an update the image you rolled off
# is normally gone by the next run, and rolling back means pulling that tag again.
# Images in use by a container are never touched, so the running version always survives.
[Unit]
Description=Prune unused Docker images and build cache

[Service]
Type=oneshot
ExecStart=/usr/bin/docker image prune -af --filter until={{ docker_prune_keep_hours }}h
ExecStart=/usr/bin/docker builder prune -f --filter until={{ docker_prune_keep_hours }}h
